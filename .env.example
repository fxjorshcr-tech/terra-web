# Copiar a .env.local para desarrollo. En Vercel: Settings → Environment Variables.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxx

# Remitente. Mientras el dominio no esté verificado en Resend, dejar sin definir
# (usa onboarding@resend.dev, que sólo entrega al correo dueño de la cuenta).
# Al verificar orozrealstate.com en Resend → Domains, definir por ejemplo:
# RESEND_FROM="Oroz Real Estate <contacto@orozrealstate.com>"

# Destinatarios del formulario, separados por coma. Por defecto:
# CONTACT_TO=orostudioscr@gmail.com,orozrealestate@gmail.com
